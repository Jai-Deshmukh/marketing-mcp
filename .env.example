# All optional. Paths are relative to the project root.
OUTPUT_DIR=./output
# Voiceover pacing used to check script length against duration_s.
WORDS_PER_SECOND=2.5
# Royalty-free music library, one folder per mood (e.g. upbeat/, calm/, warm/).
MUSIC_DIR=./src/brand/assets/music
# auto | kokoro | say   (auto = Kokoro when installed, macOS say otherwise)
VOICE_ENGINE=auto
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
